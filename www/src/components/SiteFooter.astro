---
import AnalyticsConsent from "./AnalyticsConsent.astro";

interface Props {
  releaseVersion?: string;
}

const { releaseVersion } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__mark">Jamula</p>
    <p class="site-footer__copy">
      &copy; {year} Jamula, Inc. All rights reserved.{" "}
      {releaseVersion && <span class="site-footer__version">Release v{releaseVersion}</span>}
    </p>
  </div>
  <AnalyticsConsent releaseVersion={releaseVersion} />
</footer>

<style>
  .site-footer {
    position: relative;
    margin-block-start: var(--j-space-16);
    padding-block: var(--j-space-8) var(--j-space-4);
    background: var(--j-deep);
  }

  .site-footer::before {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: 3px;
    background: var(--j-ochre);
    content: "";
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--j-space-3) var(--j-space-6);
    max-width: var(--j-max-width);
    margin-inline: auto;
    padding-inline: var(--j-space-6);
  }

  .site-footer__mark {
    color: var(--j-white);
    font-family: var(--j-font-display);
    font-size: var(--j-text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .site-footer__copy {
    max-width: none;
    color: var(--j-cloth);
    font-size: var(--j-text-sm);
  }

  .site-footer__version {
    margin-inline-start: var(--j-space-2);
    padding-inline-start: var(--j-space-2);
    border-inline-start: 1px solid currentColor;
  }

  @media (max-width: 32rem) {
    .site-footer__inner {
      padding-inline: var(--j-space-4);
    }
  }
</style>
