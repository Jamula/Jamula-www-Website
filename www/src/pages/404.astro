---
/**
 * 404 Not Found — required by Azure Static Web Apps for custom 404s.
 * See: https://learn.microsoft.com/azure/static-web-apps/configuration
 */
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The page you are looking for could not be found.">
  <div class="not-found">
    <h1>Page not found</h1>
    <p>The page you are looking for does not exist or has moved.</p>
    <a href="/">Return to the home page</a>
  </div>
</BaseLayout>

<style>
  .not-found {
    max-width: var(--j-max-width);
    margin-inline: auto;
    padding-inline: var(--j-space-4);
    padding-block: var(--j-space-16);
    display: flex;
    flex-direction: column;
    gap: var(--j-space-4);
  }

  .not-found h1 {
    font-size: var(--j-text-3xl);
  }
</style>
