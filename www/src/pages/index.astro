---
/**
 * Home — Woven Plane.
 *
 * The homepage keeps the approved offer, service descriptions, and existing
 * contact path while moving their order into the approved crossing composition.
 */
import BaseLayout from "../layouts/BaseLayout.astro";

const organizationStructuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://jamula.net/#organization",
  name: "Jamula",
  url: "https://jamula.net/",
  logo: "https://jamula.net/apple-touch-icon.png",
};
---

<BaseLayout
  title="AI Strategy, Custom Software & Cloud Consulting"
  description="Jamula works across AI strategy, custom software, and cloud consulting in a single engagement — so what we recommend is also what we build and run."
  canonicalUrl="https://jamula.net/"
  structuredData={organizationStructuredData}
>
  <div class="home">
    <!-- DESIGN CONTRACT
    THESIS: AI strategy, custom software, and cloud consulting cross as one offer, not three cards.
    OWN-WORLD: Deep teal ground, pale cloth and sage bands, a controlled ochre seam, and confident system typography.
    STORY: Understand the integrated engagement first, then read the synthesis, services, method, and next step.
    FIRST VIEWPORT: The offer and “Together — not as separate projects.” dominate the crossing between offset flat bands.
    FORM: Woven Plane, approved composition C — The crossing; seed 5acca6c6 as provided by the direction-choice task. -->

    <section class="crossing" aria-labelledby="offer-heading">
      <div class="crossing__plane">
        <div class="crossing__top" aria-hidden="true"></div>
        <div class="crossing__rail" aria-hidden="true"></div>
        <div class="crossing__bottom" aria-hidden="true"></div>

        <div class="crossing__offer">
          <h1 id="offer-heading" class="crossing__headline">
            <span>AI strategy.</span>
            <span>Custom software.</span>
            <span>Cloud consulting.</span>
          </h1>
          <p class="crossing__together">Together — not as separate projects.</p>
        </div>

        <p class="crossing__lead">
          Organizations exploring AI often receive advice that stops before it reaches their
          systems. Jamula doesn&rsquo;t stop there. We work across AI strategy, custom software, and
          cloud infrastructure in a single engagement, so what we recommend is also what we build
          and run.
        </p>
      </div>
    </section>

    <section class="synthesis" id="synthesis" aria-labelledby="synthesis-heading">
      <h2 id="synthesis-heading" class="synthesis__heading">
        Three disciplines, one engagement
      </h2>
      <div class="synthesis__body">
        <p class="synthesis__sequence">The three, rejoined</p>
        <p>
          The problem with separate AI, software, and cloud engagements is that strategy
          doesn&rsquo;t survive the handoffs. A strategy that can&rsquo;t be built doesn&rsquo;t get
          used. Software that can&rsquo;t run in the cloud doesn&rsquo;t work at scale. Jamula keeps
          all three under one engagement so decisions stay consistent from the whiteboard to the
          server.
        </p>
        <p>
          An engagement with Jamula typically starts with understanding: what you&rsquo;re trying to
          accomplish, what you already have, and where the real constraints are. From there, we
          recommend what we think you need &mdash; including when the answer is less than you might
          expect &mdash; and carry that recommendation through design, build, and operation.
        </p>
      </div>
    </section>

    <div class="services" id="services">
      <section class="service service--ai" aria-labelledby="offer-ai">
        <h2 id="offer-ai" class="service__heading">
          AI Strategy
        </h2>
        <div class="service__body">
          <p class="service__sequence">One of three</p>
          <p>
            Artificial intelligence creates real choices &mdash; and real ways to get them wrong.
            Jamula helps organizations think clearly about AI: what it can do for your situation,
            what it cannot do, and how to make a decision that holds up.
          </p>
          <p>
            That means grounded scoping before any commitment, honest assessment of capability and
            risk, and a strategy you can evaluate against something measurable &mdash; defined
            before work starts.
          </p>
          <p class="service__includes">What this engagement includes</p>
          <ul class="service__list" role="list">
            <li>Evaluation of AI fit for a specific business problem</li>
            <li>Identification of the right approach, tools, and level of investment</li>
            <li>Honest characterization of limitations and conditions for success</li>
            <li>A decision frame that survives scrutiny &mdash; internally and from customers</li>
          </ul>
        </div>
      </section>

      <section class="service service--software" aria-labelledby="offer-software">
        <h2 id="offer-software" class="service__heading">
          Custom Software
        </h2>
        <div class="service__body">
          <p class="service__sequence">Two of three</p>
          <p>
            Off-the-shelf tools solve standard problems. When your problem isn&rsquo;t standard
            &mdash; or when you&rsquo;re building the capability that makes your organization
            different &mdash; custom software is the answer.
          </p>
          <p>
            Jamula designs and builds software for the specific problem at hand: the workflow that
            doesn&rsquo;t fit a template, the integration that existing products can&rsquo;t make,
            the tool that turns your AI strategy into something your team actually uses.
          </p>
          <p class="service__includes">What this engagement includes</p>
          <ul class="service__list" role="list">
            <li>Design and development of purpose-built applications and integrations</li>
            <li>Architecture that separates your business logic from the platforms it runs on</li>
            <li>
              Delivery with clear scope, a testable definition of done, and documented handoffs
            </li>
            <li>
              Software built to be operated, maintained, and eventually replaced &mdash; not locked
              in
            </li>
          </ul>
        </div>
      </section>

      <section class="service service--cloud" aria-labelledby="offer-cloud">
        <h2 id="offer-cloud" class="service__heading">
          Cloud Consulting
        </h2>
        <div class="service__body">
          <p class="service__sequence">Three of three</p>
          <p>
            Cloud infrastructure done well is invisible &mdash; it doesn&rsquo;t slow software down,
            it doesn&rsquo;t surprise you on a bill, and it doesn&rsquo;t create problems when you
            need to move.
          </p>
          <p class="service__includes">What this engagement includes</p>
          <ul class="service__list" role="list">
            <li>
              Infrastructure design and implementation for cloud-hosted software and AI workloads
            </li>
            <li>
              Cost, reliability, and operations planning &mdash; including the assumptions behind
              each tradeoff
            </li>
            <li>Documentation sufficient to run, audit, and transfer the infrastructure</li>
            <li>A path that keeps your options open</li>
          </ul>
        </div>
      </section>
    </div>

    <section class="passage" id="approach" aria-labelledby="approach-heading">
      <p class="woven-label">Method</p>
      <h2 id="approach-heading" class="passage__heading">
        How we approach AI
      </h2>
      <div class="passage__body">
        <p>
          Jamula&rsquo;s work on AI starts from a practical question: what will this actually do,
          for this organization, in this situation? That question is harder than it sounds.
        </p>
        <p>
          Jamula starts by checking whether incomplete data, unclear objectives, or untested
          assumptions are the real problem. We work to surface those problems early &mdash; before
          the commitment, before the build &mdash; because an honest scoping conversation is more
          valuable than a confident one.
        </p>
        <p>
          We don&rsquo;t claim AI is safe by default, and we don&rsquo;t claim any particular AI
          implementation is safe until we can evaluate it against something measurable. We aim to
          make the evaluation criteria clear and to tell you what we find.
        </p>
      </div>
    </section>

    <section class="passage passage--about" id="about" aria-labelledby="about-heading">
      <p class="woven-label">About</p>
      <h2 id="about-heading" class="passage__heading">
        About Jamula
      </h2>
      <div class="passage__body">
        <p class="passage__lede">Cyrus Jamula founded Jamula.</p>
      </div>
    </section>

    <section class="next" id="next" aria-labelledby="next-heading">
      <p class="woven-label">Where to start</p>
      <h2 id="next-heading" class="next__heading">
        Read it as one engagement
      </h2>
      <div class="next__body">
        <p>
          If you&rsquo;re weighing whether AI has a real application in your organization, or
          whether your software or infrastructure needs are something Jamula can help with, the
          place to start is seeing how the three disciplines work as one.
        </p>
        <p>
          We&rsquo;ll tell you honestly what we think &mdash; including whether we&rsquo;re a good
          fit or whether someone else is better suited.
        </p>
        <p class="next__action">
          <a href="#synthesis">Re-read how the three disciplines combine</a>
        </p>
        <p class="next__action">
          <a href="mailto:spam@jamula.net" data-analytics-contact>
            Contact Jamula, Inc.
          </a>
        </p>
        <p>
          If the email link does not open your mail app, copy this address:{" "}
          <span class="next__email">spam@jamula.net</span>
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    --home-gutter: var(--j-space-6);
    max-width: var(--j-max-width);
    margin-inline: auto;
    padding-inline: var(--home-gutter);
  }

  .crossing {
    padding-block: clamp(var(--j-space-8), 7vw, var(--j-space-16));
  }

  .crossing__plane {
    position: relative;
    display: grid;
    grid-template-columns: 15% minmax(0, 1fr) 22%;
    grid-template-rows: 3.75rem minmax(22rem, auto) 4.5rem;
  }

  .crossing__top,
  .crossing__rail,
  .crossing__bottom {
    pointer-events: none;
  }

  .crossing__top {
    grid-column: 1 / -1;
    grid-row: 1;
    border-inline-end: 1.1rem solid var(--j-ochre);
    background: var(--j-sage);
  }

  .crossing__rail {
    grid-column: 1;
    grid-row: 2 / 4;
    background: var(--j-sage);
  }

  .crossing__bottom {
    grid-column: 2 / -1;
    grid-row: 3;
    border-block-end: 0.6rem solid var(--j-ochre);
    background: var(--j-cloth);
  }

  .crossing__offer {
    z-index: 1;
    grid-column: 2 / 3;
    grid-row: 2;
    padding: clamp(var(--j-space-6), 4.5vw, var(--j-space-12));
    background: var(--j-cloth);
    color: var(--j-deep);
  }

  .crossing__headline {
    max-width: none;
    font-size: var(--j-display-1);
    font-weight: 720;
    line-height: 0.98;
    letter-spacing: var(--j-tracking-display);
  }

  .crossing__headline span {
    display: block;
    overflow-wrap: break-word;
  }

  .crossing__together {
    display: inline-block;
    margin-block-start: var(--j-space-6);
    padding: var(--j-space-3) var(--j-space-4);
    background: var(--j-deep);
    color: var(--j-cloth);
    font-family: var(--j-font-display);
    font-size: var(--j-text-lg);
    font-weight: 650;
    line-height: var(--j-leading-snug);
  }

  .crossing__lead {
    z-index: 1;
    grid-column: 3;
    grid-row: 2;
    max-width: none;
    padding: clamp(var(--j-space-4), 2.5vw, var(--j-space-8));
    align-self: stretch;
    background: var(--j-deep);
    color: var(--j-cloth);
    font-size: var(--j-text-lg);
    line-height: var(--j-leading-snug);
  }

  .synthesis {
    display: grid;
    grid-template-columns: minmax(15rem, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(var(--j-space-6), 5vw, var(--j-space-12));
    margin-inline: calc(-1 * var(--home-gutter));
    padding: clamp(var(--j-space-8), 7vw, var(--j-space-16)) var(--home-gutter);
    background: var(--j-cloth);
    color: var(--j-deep);
  }

  .synthesis__heading {
    max-width: 12ch;
    font-size: var(--j-display-2);
  }

  .synthesis__body {
    display: grid;
    gap: var(--j-space-4);
    max-width: 68ch;
  }

  .synthesis__body p {
    font-size: var(--j-text-lg);
  }

  .synthesis__sequence,
  .service__sequence {
    color: var(--j-deep);
    font-size: var(--j-text-sm) !important;
    font-weight: 700;
    letter-spacing: var(--j-tracking-label);
    text-transform: uppercase;
  }

  .services {
    padding-block: var(--j-space-8);
  }

  .service {
    display: grid;
    grid-template-columns: minmax(13rem, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(var(--j-space-6), 5vw, var(--j-space-12));
    padding: clamp(var(--j-space-8), 5vw, var(--j-space-12)) var(--j-space-6);
    color: var(--j-deep);
  }

  .service + .service {
    border-block-start: 1px solid rgb(22 45 50 / 38%);
  }

  .service--ai,
  .service--cloud {
    background: var(--j-cloth);
  }

  .service--software {
    background: var(--j-sage);
  }

  .service__heading {
    max-width: 11ch;
    font-size: var(--j-display-2);
  }

  .service__body {
    display: grid;
    gap: var(--j-space-4);
    max-width: 68ch;
  }

  .service__body p {
    font-size: var(--j-text-lg);
  }

  .service__includes {
    margin-block-start: var(--j-space-4);
    padding-block-start: var(--j-space-3);
    border-block-start: 2px solid var(--j-deep);
    font-weight: 700;
  }

  .service__list {
    display: grid;
    gap: var(--j-space-3);
    list-style: none;
  }

  .service__list li {
    position: relative;
    max-width: none;
    padding-inline-start: var(--j-space-6);
    line-height: var(--j-leading-snug);
  }

  .service__list li::before {
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.62em;
    width: var(--j-space-4);
    height: 2px;
    background: var(--j-deep);
    content: "";
  }

  .passage {
    padding-block: var(--j-space-12);
    border-block-start: 1px solid var(--j-sage);
  }

  .passage__heading,
  .next__heading {
    max-width: 20ch;
    margin-block: var(--j-space-2) var(--j-space-6);
    font-size: var(--j-display-2);
  }

  .passage__body,
  .next__body {
    display: grid;
    gap: var(--j-space-4);
    max-width: 68ch;
  }

  .passage__body p,
  .next__body p {
    font-size: var(--j-text-lg);
  }

  .passage__lede {
    font-family: var(--j-font-display);
    font-size: var(--j-text-2xl) !important;
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: var(--j-leading-snug);
  }

  .next {
    margin-inline: calc(-1 * var(--home-gutter));
    padding: clamp(var(--j-space-8), 6vw, var(--j-space-12)) var(--home-gutter);
    background: var(--j-sage);
    color: var(--j-deep);
  }

  .next .woven-label {
    color: var(--j-deep);
  }

  .next__body {
    max-width: 60ch;
  }

  .next__action {
    margin-block-start: var(--j-space-2);
  }

  .next__action a {
    display: inline-block;
    min-height: 44px;
    padding-block: var(--j-space-2);
    border-block-end: 2px solid var(--j-ochre);
    color: var(--j-deep);
    font-size: var(--j-text-lg);
    font-weight: 700;
    text-decoration: none;
  }

  .next__action a:hover {
    border-block-end-width: 4px;
    color: var(--j-deep);
  }

  .next__email {
    overflow-wrap: anywhere;
  }

  .synthesis :focus-visible,
  .service :focus-visible,
  .next :focus-visible {
    outline-color: var(--j-deep);
  }

  @media (max-width: 56rem) {
    .crossing__plane {
      grid-template-columns: 12% minmax(0, 1fr);
      grid-template-rows: 3rem minmax(18rem, auto) auto 3.5rem;
    }

    .crossing__top {
      border-inline-end-width: 0.75rem;
    }

    .crossing__rail {
      grid-column: 1;
      grid-row: 2 / 5;
    }

    .crossing__offer {
      grid-column: 2 / -1;
      grid-row: 2;
      margin-inline-start: 0;
      padding-inline-start: clamp(var(--j-space-6), 8vw, var(--j-space-12));
    }

    .crossing__lead {
      grid-column: 2;
      grid-row: 3;
      padding-inline: var(--j-space-6);
    }

    .crossing__bottom {
      grid-column: 2 / -1;
      grid-row: 4;
    }

    .synthesis {
      grid-template-columns: 1fr;
      gap: var(--j-space-4);
    }

    .synthesis__heading {
      max-width: 18ch;
    }
  }

  @media (max-width: 42rem) {
    .home {
      --home-gutter: var(--j-space-4);
    }

    .crossing__plane {
      display: block;
      padding-block-start: 2.5rem;
      padding-block-end: 2.25rem;
    }

    .crossing__top {
      position: absolute;
      inset-block-start: 0;
      inset-inline: 0;
      height: 2.5rem;
      border-inline-end-width: 0.6rem;
    }

    .crossing__rail {
      position: absolute;
      inset-block: 2.5rem 1rem;
      inset-inline-start: 0;
      width: 0.55rem;
    }

    .crossing__offer {
      position: relative;
      margin-inline-start: 0.8rem;
      padding: var(--j-space-6) var(--j-space-4);
    }

    .crossing__headline {
      font-size: var(--j-display-1);
    }

    .crossing__together {
      font-size: var(--j-text-base);
    }

    .crossing__lead {
      position: relative;
      margin-inline-start: 1.6rem;
      padding: var(--j-space-4);
      font-size: var(--j-text-base);
    }

    .crossing__bottom {
      position: absolute;
      inset-block-end: 0;
      inset-inline: 1.6rem 0;
      height: 2.25rem;
    }

    .service {
      grid-template-columns: 1fr;
      gap: var(--j-space-4);
      padding-inline: var(--j-space-4);
    }

    .service__heading {
      max-width: none;
    }

    .passage {
      padding-block: var(--j-space-8);
    }
  }
</style>
