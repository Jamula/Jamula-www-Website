---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const notes = await getCollection("tech");
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<BaseLayout
  title={note.data.title}
  description={note.data.description}
  canonicalUrl={`https://jamula.net/tech/${note.id}/`}
>
  <article class="tech-article">
    <div class="tech-article__header">
      <p class="woven-label">Published {note.data.publishedDate}</p>
      <h1 class="tech-article__title">{note.data.title}</h1>
      <p class="tech-article__summary">{note.data.summary}</p>
    </div>

    <div class="tech-article__body">
      <Content />
    </div>

    <p class="tech-article__back">
      <a href="/tech/">Back to technical notes</a>
    </p>
  </article>
</BaseLayout>

<style>
  .tech-article {
    max-width: var(--j-max-width);
    margin-inline: auto;
    padding-inline: var(--j-space-6);
  }

  .tech-article__header {
    padding: clamp(var(--j-space-8), 6vw, var(--j-space-12)) var(--j-space-6);
    margin-block-start: var(--j-space-8);
    border-block-end: 4px solid var(--j-ochre);
    background: var(--j-cloth);
    color: var(--j-deep);
  }

  .tech-article__header .woven-label {
    color: var(--j-deep);
  }

  .tech-article__title {
    max-width: 24ch;
    margin-block: var(--j-space-3) var(--j-space-4);
    font-size: var(--j-display-2);
  }

  .tech-article__summary {
    max-width: var(--j-content-width);
    font-size: var(--j-text-lg);
  }

  .tech-article__body {
    max-width: var(--j-content-width);
    padding-block: var(--j-space-12);
  }

  .tech-article__body :global(h2) {
    margin-block: var(--j-space-8) var(--j-space-4);
    font-size: var(--j-text-2xl);
  }

  .tech-article__body :global(h2:first-child) {
    margin-block-start: 0;
  }

  .tech-article__body :global(p) {
    margin-block-start: var(--j-space-4);
    color: var(--j-cloth);
    font-size: var(--j-text-lg);
  }

  .tech-article__back {
    padding-block: var(--j-space-6);
    border-block-start: 1px solid var(--j-sage);
  }

  .tech-article__back a {
    display: inline-block;
    min-height: 44px;
    padding-block: var(--j-space-2);
    border-block-end: 2px solid var(--j-ochre);
    color: var(--j-white);
    font-weight: 700;
    text-decoration: none;
  }

  .tech-article__back a:hover {
    border-block-end-width: 4px;
  }

  @media (max-width: 46rem) {
    .tech-article {
      padding-inline: var(--j-space-4);
    }

    .tech-article__header {
      padding-inline: var(--j-space-4);
    }
  }
</style>
