<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- .NET 10 LTS is supported through November 2028.
         CI installs the SDK selected by scripts/monitor/global.json. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>JamulaMonitor</AssemblyName>
    <RootNamespace>JamulaMonitor</RootNamespace>
  </PropertyGroup>
  <!-- No third-party NuGet packages; BCL only. -->
</Project>
